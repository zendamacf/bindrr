# Production Docker Compose (.env next to docker-compose.yml on the VPS)
DB_PASSWORD=
AUTH_SECRET=
OPENEXCHANGERATES_APPID=
CRON_SECRET=
PUBLIC_SENTRY_DSN=
APP_PORT=3000
# Published image from a v* tag (see .github/workflows/publish-docker.yml)
APP_IMAGE=ghcr.io/zendamacf/bindrr:latest

# Optional application rate limits (per instance; see docs/operations.md)
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_SEARCH_MAX=60
# RATE_LIMIT_SEARCH_WINDOW_MS=60000
# RATE_LIMIT_API_AUTH_MAX=300
# RATE_LIMIT_API_AUTH_WINDOW_MS=60000
# RATE_LIMIT_API_ANON_MAX=60
# RATE_LIMIT_API_ANON_WINDOW_MS=60000
